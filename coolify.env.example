# Coolify environment template for KA-database
# Copy these key/value pairs into Coolify -> Service -> Environment Variables.

# Required: dashboard login
KA_DASHBOARD_USERNAME=admin
KA_DASHBOARD_PASSWORD=change-me-strong-password

# Recommended for VPS persistence (mount a volume at /data)
KA_DATA_DIR=/data

# Optional source file overrides (leave unset unless needed)
# KA_SOURCES_FILE=/data/sources.txt
# KA_FEEDS_FILE=/data/feeds.txt

# Optional ingestion/discovery tuning
KA_MAX_ENTRIES_PER_FEED=50
KA_MAX_CANDIDATES_PER_SOURCE=60
KA_MAX_LISTING_PAGES_PER_SOURCE=2
KA_MAX_SITEMAP_URLS_PER_SOURCE=120
KA_MAX_SITEMAP_SCAN_URLS_PER_SOURCE=800
KA_MAX_AGE_DAYS_SITEMAP_LISTING=183
